NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/new-chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/new-chat

DATABASE_URL=postgresql://yourunique:yourunique@localhost:5436/yourunique_cv
CLERK_WEBHOOK_SECRET=

OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
SCRAPECREATORS_API_KEY=

# FloppyData HTTP(S) proxy for job posting fetches in Trigger.
# Required for fetch-linkedin-job / fetch-job-posting on Trigger Cloud — set the same value in the Trigger dashboard.
# FD_PROXY_URL=

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

DODO_PAYMENTS_API_KEY=
# Optional override; defaults to http://localhost:6700/new-chat locally,
# or https://$VERCEL_URL/new-chat on Vercel. Dodo env is derived from NODE_ENV
# (production → live_mode, otherwise test_mode).
DODO_PAYMENTS_RETURN_URL=
DODO_WEBHOOK_SECRET=
DODO_PRO_PRODUCT_ID=
DODO_LIFETIME_PRODUCT_ID=
SUPPORT_EMAIL=

# Optional absolute app URL used in agent download links (defaults to VERCEL_URL or localhost:6700)
NEXT_PUBLIC_APP_URL=

# Mixpanel project token. Production-only; local and localhost are skipped.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Trigger.dev — set in Trigger dashboard for compile-resume / generate-resume-template
# (also needs DATABASE_URL + R2_* + OPENROUTER_API_KEY). Locally: bunx playwright install chromium
# TRIGGER_SECRET_KEY=
