NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/new-chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/new-chat

DATABASE_URL=postgresql://yourunique:yourunique@localhost:5436/yourunique_cv
CLERK_WEBHOOK_SECRET=

OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

DODO_PAYMENTS_API_KEY=
# Optional override; defaults to http://localhost:6700/settings locally,
# or https://$VERCEL_URL/settings on Vercel. Dodo env is derived from NODE_ENV
# (production → live_mode, otherwise test_mode).
DODO_PAYMENTS_RETURN_URL=
DODO_WEBHOOK_SECRET=
DODO_PRO_PRODUCT_ID=
SUPPORT_EMAIL=

# Optional absolute app URL used in agent download links (defaults to VERCEL_URL or localhost:6700)
NEXT_PUBLIC_APP_URL=

# Trigger.dev — set in Trigger dashboard for compile-resume (also needs DATABASE_URL + R2_*)
# TRIGGER_SECRET_KEY=
# Local typst binary override for Trigger.dev / compile (defaults to PATH / ~/.local/bin/typst)
# TYPST_PATH=
